# Shared secret BE/ sends in the X-AI-Secret header. Must match BE's AI_SHARED_SECRET.
# Required: the service refuses every request when it is empty.
AI_SHARED_SECRET=

# Anthropic API key (from Phase B's model step on). Lives only here and in the
# deployed AI service's environment, never in BE/ or FE/.
# ANTHROPIC_API_KEY=

# Which model answers: none (default), ollama (local) or claude.
# AI_BACKEND=none
# Model id (decision 10): e.g. claude-haiku-5-5, or an Ollama model name.
# AI_MODEL=claude-haiku-5-5
# Claude thinking effort: low (default, measured best here), medium or high.
# AI_EFFORT=low

# Categories never suggested, because the statement can't show them (a gift
# looks like any other purchase). JSON list.
# AI_NEVER_SUGGEST='["Gifts"]'

# Eval only: the card's account name in the app, so label guesses use only
# expenses entered on that card. Empty: any account.
# EVAL_CARD_ACCOUNT=

LOG_LEVEL=INFO
