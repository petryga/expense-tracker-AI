# Shared secret BE/ sends in the X-AI-Secret header. Must match BE's AI_SHARED_SECRET.
# Required: the service refuses every request when it is empty.
AI_SHARED_SECRET=

# Anthropic API key (from Phase B's model step on). Lives only here and in the
# deployed AI service's environment, never in BE/ or FE/.
# ANTHROPIC_API_KEY=

# Model id (decision 10). Start with claude-opus-5-5, compare claude-haiku-5-5.
# AI_MODEL=claude-opus-5-5

LOG_LEVEL=INFO
