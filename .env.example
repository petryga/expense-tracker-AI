# Shared secret BE/ sends in the X-AI-Secret header. Must match BE's AI_SHARED_SECRET.
# Required: the service refuses every request when it is empty.
AI_SHARED_SECRET=

# Anthropic API key (from Phase B's model step on). Lives only here and in the
# deployed AI service's environment, never in BE/ or FE/.
# ANTHROPIC_API_KEY=

# Which model answers: none (default), ollama (local) or claude.
# AI_BACKEND=none
# Model id (decision 10): e.g. claude-haiku-5-5, or an Ollama model name.
# AI_MODEL=claude-haiku-5-5
# Claude thinking effort: low (default, measured best here), medium or high.
# AI_EFFORT=low

# Retrieval of past choices for order items (optional). A Postgres URL for a
# role limited to the category_examples table (see README). Needs the
# embeddings extra: pip install -e '.[embeddings]'
# AI_DATABASE_URL=postgresql://expense_tracker_ai@127.0.0.1:5432/expense_tracker
# AI_EXAMPLES_K=3

# The spending assistant (POST /ask) runs the MCP server (the MCP/ repo, built
# with npm run build) and reaches the Expense Tracker API through it.
# MCP_SERVER_COMMAND=node
# MCP_SERVER_ARGS=../MCP/dist/index.js
# EXPENSE_TRACKER_API_URL=http://localhost:3000
# AI_AGENT_MODEL=claude-haiku-5-5

# Eval only: the card's account name in the app, so label guesses use only
# expenses entered on that card. Empty: any account.
# EVAL_CARD_ACCOUNT=

LOG_LEVEL=INFO
