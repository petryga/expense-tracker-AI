#!/bin/sh
# Privacy check: blocks a commit that would publish real statement or order
# data, or name the owner's banks. The checker lives outside this repo because
# it reads private files, so it runs only where it exists.
# Enable once per clone: git config core.hooksPath .githooks
checker="$(git rev-parse --show-toplevel)/../tools/privacy_check.py"
if [ -f "$checker" ]; then
  python3 "$checker" --no-bank-names || exit 1
fi
